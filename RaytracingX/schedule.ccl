# Schedule definition for thorn RaytracingX
# ===================================================

if (do_raytracing) {

SCHEDULE R_ParticlesContainer_setup AT CCTK_POSTINITIAL {
    LANG: C
    OPTIONS: global
} "setup"

if ((particle_plot_every>0)||(particle_tsv_every>0) ){
    SCHEDULE R_ParticlesContainer_print AT CCTK_POSTINITIAL AFTER setup
    {
        LANG: C
        OPTIONS: global
    } "print the particles"
}

SCHEDULE AnalyticalSpacetimeX_SwitchOnSettingMetric IN evol BEFORE R_ParticlesContainer_evolve
  {
    LANG: C
    OPTIONS: global
  } "set flag is_setting_metric to true after regrid"

SCHEDULE R_ParticlesContainer_evolve AT evol
{
    LANG: C
    OPTIONS: global
} "Photons evolution"

SCHEDULE AnalyticalSpacetimeX_SwitchOffSettingMetric IN evol AFTER R_ParticlesContainer_evolve
  {
    LANG: C
    OPTIONS: global
  } "reset flag is_setting_metric to false"

if ((particle_plot_every||particle_tsv_every) ) {
    SCHEDULE R_ParticlesContainer_print AT evol AFTER R_ParticlesContainer_evolve
    {
        LANG: C
        OPTIONS: global
    } "print the particles"
}

SCHEDULE R_ParticlesContainer_final_cleanup at CCTK_SHUTDOWN{
    LANG: C
    OPTIONS: global
} "cleaning everything"

}
