# Schedule definition for thorn RaytracingX
# ===================================================

if (do_raytracing)
{

SCHEDULE GROUP RaytracingX_Setup IN CCTK_INITIAL BEFORE ODESolvers_Initial # ---------------------------------------------------- GROUP RaytracingX_Setup
{
} "Set up raytracing particle initial time, check parameters, and check camera location"

SCHEDULE CheckParamaters IN RaytracingX_Setup
{
  LANG: C
  OPTIONS: global
} "Checks input parameters"

SCHEDULE CheckCamera IN RaytracingX_Setup AFTER CheckParamaters
{
  LANG: C
  OPTIONS: global
  WRITES: RaytracingX_scalars
} "Set up relevent camera data and particle initial time"

SCHEDULE GROUP RaytracingX_Init AT CCTK_POSTINITIAL # ---------------------------------------------------- GROUP RaytracingX_Init
{
} "Initialize raytracing particles"

SCHEDULE ParticlesInit IN RaytracingX_Init
{
  LANG: C
  OPTIONS: global
} "Initialize raytracing particles"

if (particle_tsv_every>0)
{
  SCHEDULE ParticlesPrint IN RaytracingX_Init AFTER ParticlesInit BEFORE CheckHorizonAndBannedRegions
  {
    LANG: C
    OPTIONS: global
  } "Output particle data at current iteration"
}

SCHEDULE CheckHorizonAndBannedRegions IN RaytracingX_Init AFTER ParticlesInit
{
  LANG: C
  OPTIONS: global
} "check particle bounds"

SCHEDULE CheckParticleNumber IN RaytracingX_Init AFTER CheckHorizonAndBannedRegions BEFORE CheckOutOfBoundsParticlesNumber
{
  LANG: C
  OPTIONS: global
} "Count raytracing particles currently present in simulation"

if (use_custom_bounds && extended_camera)
{
  SCHEDULE CheckOutOfBoundsParticlesNumber IN RaytracingX_Init AFTER CheckParticleNumber BEFORE ParticlesEUpdateCustomTimevolveK1
  {
    LANG: C
    OPTIONS: global
  } "Count raytracing particles currently outside specified bounds but inside grid bounds"
}

if (!fast_light) {
  SCHEDULE UpdateCustomTime IN RaytracingX_Init AFTER CheckHorizonAndBannedRegions
  {
    LANG: C
    OPTIONS: global
    READS: RaytracingX_scalars
    WRITES: RaytracingX_scalars
  } "Update time variable associated with raytracing evolution by dt"
}

SCHEDULE GROUP RaytracingX_Evol AT CCTK_EVOL # ---------------------------------------------------- GROUP RaytracingX_Evol
{
} "Evolve raytracing particles"

SCHEDULE ParticlesRedistribute AS ParticlesRedistributePrestep IN RaytracingX_Evol
{
  LANG: C
  OPTIONS: global
} "Redistribute raytracing particles via AMReX (in case of regridding)"

SCHEDULE CheckHorizonAndBannedRegions IN RaytracingX_Evol AFTER ParticlesRedistributePrestep
{
  LANG: C
  OPTIONS: global
} "check particle bounds"

SCHEDULE CheckParticleNumber IN RaytracingX_Evol AFTER CheckHorizonAndBannedRegions BEFORE CheckOutOfBoundsParticlesNumber
{
  LANG: C
  OPTIONS: global
} "Count raytracing particles currently present in simulation"

if (use_custom_bounds && extended_camera)
{
  SCHEDULE CheckOutOfBoundsParticlesNumber IN RaytracingX_Evol AFTER CheckParticleNumber BEFORE ParticlesEvolveK1
  {
    LANG: C
    OPTIONS: global
  } "Count raytracing particles currently outside specified bounds but inside grid bounds"
}

SCHEDULE ParticlesEvolveK1 IN RaytracingX_Evol AFTER CheckHorizonAndBannedRegions
{
  LANG: C
  OPTIONS: global
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::curv(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: AsterMasks::aster_mask_vc(everywhere)
  READS: RaytracingX_scalars
} "Do the first substep of RK4 method for particle evolution"

SCHEDULE ParticlesEvolveK2 IN RaytracingX_Evol AFTER ParticlesEvolveK1
{
  LANG: C
  OPTIONS: global
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::curv(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: AsterMasks::aster_mask_vc(everywhere)
  READS: RaytracingX_scalars
} "Do the second substep of RK4 method for particle evolution"

SCHEDULE ParticlesEvolveK3 IN RaytracingX_Evol AFTER ParticlesEvolveK2
{
  LANG: C
  OPTIONS: global
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::curv(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: AsterMasks::aster_mask_vc(everywhere)
  READS: RaytracingX_scalars
} "Do the third substep of RK4 method for particle evolution"

SCHEDULE ParticlesEvolveK4 IN RaytracingX_Evol AFTER ParticlesEvolveK4
{
  LANG: C
  OPTIONS: global
  READS: ADMBaseX::metric(everywhere)
  READS: ADMBaseX::curv(everywhere)
  READS: ADMBaseX::lapse(everywhere)
  READS: ADMBaseX::shift(everywhere)
  READS: AsterMasks::aster_mask_vc(everywhere)
  READS: RaytracingX_scalars
} "Do the fourth substep of RK4 method for particle evolution"

if (calculate_kerr_conserved_quantities)
{
  SCHEDULE CalculateKerrConserved IN RaytracingX_Evol AFTER ParticlesEvolveK4 BEFORE ParticlesPrint
  {
    LANG: C
    OPTIONS: global
  } "Calculate conserved quantities for particles in Kerr spacetime and output in U0, U1, and U2"
}

if (particle_tsv_every>0)
{
  SCHEDULE ParticlesPrint IN RaytracingX_Evol AFTER CalculateKerrConserved BEFORE ParticlesPrintFinalData
  {
    LANG: C
    OPTIONS: global
  } "Output particle data at current iteration"
}

if (output_final_data)
{
  SCHEDULE ParticlesPrintFinalData IN RaytracingX_Evol AFTER ParticlesPrint BEFORE ParticlesRedistributePoststep
  {
    LANG: C
    OPTIONS: global
  } "Output particle data if particle was terminated"
}

SCHEDULE ParticlesRedistribute AS ParticlesRedistributePoststep IN RaytracingX_Evol AFTER ParticlesPrint
{
  LANG: C
  OPTIONS: global
} "Redistribute raytracing particles via AMReX"

if (!fast_light)
{
  SCHEDULE UpdateCustomTime IN RaytracingX_Evol AFTER ParticlesRedistributePoststep
  {
    LANG: C
    OPTIONS: global
    READS: RaytracingX_scalars
    WRITES: RaytracingX_scalars
  } "update time variable associated with raytracing evolution by dt"
}

SCHEDULE GROUP RaytracingX_Shutdown IN CCTK_SHUTDOWN # ---------------------------------------------------- GROUP RaytracingX_SHUTDOWN
{
} "Set up raytracing particle initial time, check parameters, and check camera location"# ---------------------------------------------------- GROUP RaytracingX_Setup

SCHEDULE ParticlesContainerCleanUp IN RaytracingX_Shutdown{
    LANG: C
    OPTIONS: global
} "Free allocated memory"

}
