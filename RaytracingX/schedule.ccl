# Schedule definition for thorn RaytracingX
# ===================================================

if (do_raytracing) {

SCHEDULE R_ParticlesContainer_setup AT CCTK_POSTINITIAL {
    LANG: C
    OPTIONS: global
} "setup"

if ((particle_plot_every>0)||(particle_tsv_every>0) ){
    SCHEDULE R_ParticlesContainer_print AT CCTK_POSTINITIAL AFTER setup
    {
        LANG: C
        OPTIONS: global
    } "print the particles"
}

SCHEDULE GROUP RAYTRACING_EVOL AT evol
{
} "evolve raytracing particles"

SCHEDULE CheckRaytracingParticleNumber IN RAYTRACING_EVOL
  {
    LANG: C
    OPTIONS: global
  } "count particles"

SCHEDULE R_ParticlesContainer_bounds_check AS R_ParticlesContainer_initial_bounds_check IN RAYTRACING_EVOL AFTER CheckRaytracingParticleNumber
  {
      LANG: C
      OPTIONS: global
  } "check particle bounds"

SCHEDULE R_ParticlesContainer_redistribute IN RAYTRACING_EVOL AFTER R_ParticlesContainer_bounds_check
  {
    LANG: C
    OPTIONS: global
  } "redistribute particles"

SCHEDULE R_ParticlesContainer_evolvek1 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_redistribute
  {
    LANG: C
    OPTIONS: global
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::curv(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: AsterMasks::aster_mask_vc(everywhere)
  } "evolve particles"

SCHEDULE R_ParticlesContainer_redistribute AS R_ParticlesContainer_redistribute_k1 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek1
  {
    LANG: C
    OPTIONS: global
  } "redistribute particles"

SCHEDULE R_ParticlesContainer_evolvek2 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek1
  {
    LANG: C
    OPTIONS: global
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::curv(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: AsterMasks::aster_mask_vc(everywhere)
  } "evolve particles"

SCHEDULE R_ParticlesContainer_redistribute AS R_ParticlesContainer_redistribute_k2 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek2
  {
    LANG: C
    OPTIONS: global
  } "redistribute particles"

SCHEDULE R_ParticlesContainer_evolvek3 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek2
  {
    LANG: C
    OPTIONS: global
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::curv(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: AsterMasks::aster_mask_vc(everywhere)
  } "evolve particles"

SCHEDULE R_ParticlesContainer_redistribute AS R_ParticlesContainer_redistribute_k3 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek3
  {
    LANG: C
    OPTIONS: global
  } "redistribute particles"

SCHEDULE R_ParticlesContainer_evolvek4 IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek3
  {
    LANG: C
    OPTIONS: global
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::curv(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: AsterMasks::aster_mask_vc(everywhere)
  } "evolve particles"

if (update_metric_between_substeps)
{

SCHEDULE R_SetMetric_plus_half_dt IN RAYTRACING_EVOL AFTER R_ParticlesContainer_redistribute_k1 BEFORE R_ParticlesContainer_evolvek2
  {
    LANG: C
    OPTIONS: LOCAL
    READS: AsterMasks::aster_mask_vc(everywhere)
    WRITES: ADMBaseX::metric(everywhere)
    WRITES: ADMBaseX::curv(everywhere)
    WRITES: ADMBaseX::lapse(everywhere)
    WRITES: ADMBaseX::shift(everywhere)
    WRITES: AsterMasks::aster_mask_vc(everywhere)
  } "change metric to cctk_time+0.5*dt"

SCHEDULE R_SetMetric_plus_dt IN RAYTRACING_EVOL AFTER R_ParticlesContainer_redistribute_k3 BEFORE R_ParticlesContainer_evolvek4
  {
    LANG: C
    OPTIONS: LOCAL
    READS: AsterMasks::aster_mask_vc(everywhere)
    WRITES: ADMBaseX::metric(everywhere)
    WRITES: ADMBaseX::curv(everywhere)
    WRITES: ADMBaseX::lapse(everywhere)
    WRITES: ADMBaseX::shift(everywhere)
    WRITES: AsterMasks::aster_mask_vc(everywhere)
  } "change metric to cctk_time+dt"

SCHEDULE R_SetMetric AS R_ResetMetric IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolvek4 BEFORE R_ParticlesContainer_output_final_data
  {
    LANG: C
    OPTIONS: LOCAL
    READS: AsterMasks::aster_mask_vc(everywhere)
    WRITES: ADMBaseX::metric(everywhere)
    WRITES: ADMBaseX::curv(everywhere)
    WRITES: ADMBaseX::lapse(everywhere)
    WRITES: ADMBaseX::shift(everywhere)
    WRITES: AsterMasks::aster_mask_vc(everywhere)
  } "reset metric to cctk_time"
}

if (calculate_kerr_conserved_quantities) {
    SCHEDULE R_ParticlesContainer_calculate_kerr_conserved IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolve BEFORE R_ParticlesContainer_print
    {
        LANG: C
        OPTIONS: global
    } "calculate conserved quantities for particles and output in U0 and U1"
}

if ((particle_plot_every||particle_tsv_every) ) {
    SCHEDULE R_ParticlesContainer_print IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolve
    {
        LANG: C
        OPTIONS: global
    } "print the particles"
}

SCHEDULE R_ParticlesContainer_output_final_data IN RAYTRACING_EVOL AFTER R_ParticlesContainer_evolve
  {
    LANG: C
    OPTIONS: global
  } "redistribute particles"

  SCHEDULE R_ParticlesContainer_redistribute AS R_ParticlesContainer_redistribute_after IN RAYTRACING_EVOL AFTER R_ParticlesContainer_output_final_data
  {
    LANG: C
    OPTIONS: global
  } "redistribute particles"

SCHEDULE R_ParticlesContainer_final_cleanup at CCTK_SHUTDOWN{
    LANG: C
    OPTIONS: global
} "cleaning everything"

}
