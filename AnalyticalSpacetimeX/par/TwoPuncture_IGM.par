# ==============================================================================
# Initial data
# ==============================================================================

# -------------------- InitBase ------------------------------------------------
InitBase::initial_data_setup_method = "init_some_levels"




# ==============================================================================
# Evolution
# ==============================================================================

# -------------------- ADMBase -------------------------------------------------
# ReadInterpolate ignores the following parameters, which are however required
# to allocate storage and for the evolution of the interpolated data
ADMBase::initial_data    = "TwoPunctures"
ADMBase::initial_lapse   = "TwoPunctures-averaged"
ADMBase::initial_shift   = "zero"
ADMBase::initial_dtlapse = "zero"
ADMBase::initial_dtshift = "zero"

ADMBase::evolution_method         = "ML_BSSN"
ADMBase::lapse_evolution_method   = "ML_BSSN"
ADMBase::shift_evolution_method   = "ML_BSSN"
ADMBase::dtlapse_evolution_method = "ML_BSSN"
ADMBase::dtshift_evolution_method = "ML_BSSN"

ADMBase::metric_type = "physical"

# FIXME: check the following parameters
ADMBase::metric_timelevels = 3 ##1
ADMBase::lapse_timelevels  = 3 ##1
ADMBase::shift_timelevels  = 3 ##1



# -------------------- HydroBase -----------------------------------------------
# ReadInterpolate ignores the following parameters, which are however required
# to allocate storage and for the evolution of the interpolated data

ActiveThorns = "Seed_Magnetic_Fields"
HydroBase::initial_hydro = "Uniform_gas"

HydroBase::initial_Aphi  = "zero"
HydroBase::initial_Avec  = "zero"
HydroBase::initial_Bvec  = "zero"
Seed_Magnetic_Fields::Afield_type = "Uniform"
Seed_Magnetic_Fields::kappa   = 0.01
Seed_Magnetic_Fields::gamma = 1.66666666666667

HydroBase::timelevels        = 3 ##1
#HydroBase::prolongation_type = "ENO"



# -------------------- TmunuBase -----------------------------------------------
TmunuBase::prolongation_type     = "none"
TmunuBase::stress_energy_at_rhs  = yes
TmunuBase::stress_energy_storage = yes
TmunuBase::timelevels            = 1



# -------------------- MoL -----------------------------------------------------
MoL::ODE_method             = "RK4"
MoL::MoL_intermediate_steps = 4
MoL::MoL_num_scratch_levels = 1



# -------------------- Time ----------------------------------------------------
#Time::dtfac = 0.25 # 0.03125  # dt_max = 2
Carpet::time_refinement_factors = "[1, 1, 2, 4, 8, 16, 32, 64, 128, 256]"

Time::dtfac = 0.25



# -------------------- ML_BSSN -------------------------------------------------
ML_BSSN::rhs_boundary_condition     = "NewRad"
ML_BSSN::initial_boundary_condition = "extrapolate-gammas"

# The beta driver is equal to 1/M, where the total ADM mass M is equal to 1
# (Hydro_Disk_ID::torus_central_mass = 1. in the CBD parfile)
ML_BSSN::betadriver      = 1.
ML_BSSN::harmonicf       = 2.    # "1+log" gauge
ML_BSSN::harmonicn       = 1     # "1+log" gauge
ML_BSSN::shiftgammacoeff = 0.75

ML_BSSN::advectLapse = 1
ML_BSSN::advectShift = 1

ML_BSSN::minimumlapse = 1.e-08



# -------------------- Dissipation ---------------------------------------------
Dissipation::epsdis = 0.1
Dissipation::order  = 5
Dissipation::vars   = "
    ML_BSSN::ml_curv
    ML_BSSN::ml_dtlapse
    ML_BSSN::ml_dtshift
    ML_BSSN::ml_gamma
    ML_BSSN::ml_lapse
    ML_BSSN::ml_log_confac
    ML_BSSN::ml_metric
    ML_BSSN::ml_shift
    ML_BSSN::ml_trace_curv
"


# -------------------- EOS -----------------------------------------------------
# In the CBD parfile, the EOS settings are:
# Hydro_Disk_ID::torus_eos_k           = 0.01
# Hydro_Disk_ID::torus_adiabatic_index = 1.66666666666667

ID_converter_ILGRMHD::K_Initial     = 0.01
ID_converter_ILGRMHD::Gamma_Initial = 1.66666666666667

IllinoisGRMHD::neos     = 1
IllinoisGRMHD::K_poly   = 0.01
IllinoisGRMHD::gamma_th = 1.66666666666667

# FIXME: *probably* not used
EOS_Omni::poly_k     = 0.01
EOS_Omni::poly_gamma = 1.66666666666667
EOS_Omni::gl_k       = 0.01
EOS_Omni::gl_gamma   = 1.66666666666667


# ----------------- IllinoisGRMHD ----------------------------------------------
IllinoisGRMHD::conserv_to_prims_debug = 0
IllinoisGRMHD::Psi6threshold          = 4.
IllinoisGRMHD::gamma_speed_limit      = 10.   # Default  ##50.  # As in the SphericalNR run
IllinoisGRMHD::damp_lorenz            = 0.20 #75  # 1.5/dt_max  # As suggested by Zach Etienne
IllinoisGRMHD::rho_b_atm          = 2.e-10
IllinoisGRMHD::tau_atm            = 2.e-12  # FIXME: same as u_atm_max, not sure if will work
IllinoisGRMHD::Symmetry               = "none"
IllinoisGRMHD::update_Tmunu           = no  # Decouple spacetime from matter evolution

##IllinoisGRMHD::rho_b_max              = 0.004  # Disabled
#IllinoisGRMHD::u_atm              = 2.e-12
#IllinoisGRMHD::atmo_falloff           = yes
#IllinoisGRMHD::rho_b_max             = 15. ##0.



# -------------------- SummationByParts ----------------------------------------
SummationByParts::order = 4



# -------------------- ADMMacros -----------------------------------------------
ADMMacros::spatial_order = 4



# -------------------- Boundary ------------------------------------------------
Boundary::radpower = 2





# ==============================================================================
# Analysis
# ==============================================================================

# -------------------- SphericalSurface ----------------------------------------
SphericalSurface::nsurfaces = 5
SphericalSurface::maxntheta = 39
SphericalSurface::maxnphi   = 76

# ***** Spherical surface for puncture 1 *****
SphericalSurface::ntheta[0]       = 39
SphericalSurface::nphi[0]         = 76
SphericalSurface::nghoststheta[0] = 2
SphericalSurface::nghostsphi[0]   = 2

# ***** Spherical surface for puncture 2 *****
SphericalSurface::ntheta[1]       = 39
SphericalSurface::nphi[1]         = 76
SphericalSurface::nghoststheta[1] = 2
SphericalSurface::nghostsphi[1]   = 2

# ***** Spherical surface for the BH formed at merger *****
SphericalSurface::ntheta[2]       = 39
SphericalSurface::nphi[2]         = 76
SphericalSurface::nghoststheta[2] = 2
SphericalSurface::nghostsphi[2]   = 2

# ***** Spherical surfaces needed by Outflow *****
SphericalSurface::set_spherical[3] = yes
SphericalSurface::radius[3]        = 15.
SphericalSurface::ntheta[3]        = 39
SphericalSurface::nphi[3]          = 76
SphericalSurface::nghoststheta[3]  = 2
SphericalSurface::nghostsphi[3]    = 2

SphericalSurface::set_spherical[4] = yes
SphericalSurface::radius[4]        = 30.
SphericalSurface::ntheta[4]        = 39
SphericalSurface::nphi[4]          = 76
SphericalSurface::nghoststheta[4]  = 2
SphericalSurface::nghostsphi[4]    = 2

# -------------------- CarpetTracker -------------------------------------------
CarpetTracker::surface[0] = 0
CarpetTracker::surface[1] = 1

# N.B.: do NOT track surface 3 (i.e., the BH formed at merger), since that does
#       not exist at the beginning and this causes the central hierarchy of
#       grids to be disabled!



# -------------------- PunctureTracker -----------------------------------------
PunctureTracker::initial_x[0] = $x_punc1
PunctureTracker::initial_y[0] = $y_punc1
PunctureTracker::initial_z[0] = $z_punc1

PunctureTracker::initial_x[1] = $x_punc2
PunctureTracker::initial_y[1] = $y_punc2
PunctureTracker::initial_z[1] = $z_punc2

PunctureTracker::track[0] = yes
PunctureTracker::track[1] = yes

PunctureTracker::which_surface_to_store_info[0] = 0
PunctureTracker::which_surface_to_store_info[1] = 1

PunctureTracker::verbose  = no



# -------------------- AHFinderDirect ------------------------------------------
AHFinderDirect::N_horizons                  = 3
AHFinderDirect::find_every                  = $regrid_analysis_factor
AHFinderDirect::output_h_every              = $regrid_analysis_factor
AHFinderDirect::output_mean_curvature_every = $regrid_analysis_factor

AHFinderDirect::move_origins            = yes
AHFinderDirect::reshape_while_moving    = yes
AHFinderDirect::predict_origin_movement = yes

AHFinderDirect::geometry_interpolator_name = "Lagrange polynomial interpolation"
AHFinderDirect::geometry_interpolator_pars = "order = 4"  # FIXME: use order = 3?
AHFinderDirect::surface_interpolator_name  = "Lagrange polynomial interpolation"
AHFinderDirect::surface_interpolator_pars  = "order = 4"  # FIXME: use order = 3?


# ***** Parameters for puncture 1 *****
AHFinderDirect::origin_x[1] = $x_punc1
AHFinderDirect::origin_y[1] = $y_punc1
AHFinderDirect::origin_z[1] = $z_punc1

AHFinderDirect::initial_guess__coord_sphere__x_center[1] = $x_punc1
AHFinderDirect::initial_guess__coord_sphere__y_center[1] = $y_punc1
AHFinderDirect::initial_guess__coord_sphere__z_center[1] = $z_punc1
AHFinderDirect::initial_guess__coord_sphere__radius[1]   = 0.29

AHFinderDirect::track_origin_from_grid_scalar[1] = yes

AHFinderDirect::track_origin_source_x[1] = "PunctureTracker::pt_loc_x[0]"
AHFinderDirect::track_origin_source_y[1] = "PunctureTracker::pt_loc_y[0]"
AHFinderDirect::track_origin_source_z[1] = "PunctureTracker::pt_loc_z[0]"

AHFinderDirect::patch_system_type[1]                 = "full sphere"
AHFinderDirect::reset_horizon_after_not_finding[1]   = yes
##AHFinderDirect::dont_find_after_individual_time[1] = 30.  # FIXME: set this equal to merger time, leave commented until merger time has been figured out
AHFinderDirect::which_surface_to_store_info[1]       = 0

# ***** Parameters for puncture 2 *****
AHFinderDirect::origin_x[2] = $x_punc2
AHFinderDirect::origin_y[2] = $y_punc2
AHFinderDirect::origin_z[2] = $z_punc2

AHFinderDirect::initial_guess__coord_sphere__x_center[2] = $x_punc2
AHFinderDirect::initial_guess__coord_sphere__y_center[2] = $y_punc2
AHFinderDirect::initial_guess__coord_sphere__z_center[2] = $z_punc2
AHFinderDirect::initial_guess__coord_sphere__radius[2]   = 0.29

AHFinderDirect::track_origin_from_grid_scalar[2] = yes

AHFinderDirect::track_origin_source_x[2] = "PunctureTracker::pt_loc_x[1]"
AHFinderDirect::track_origin_source_y[2] = "PunctureTracker::pt_loc_y[1]"
AHFinderDirect::track_origin_source_z[2] = "PunctureTracker::pt_loc_z[1]"

AHFinderDirect::patch_system_type[2]                 = "full sphere"
AHFinderDirect::reset_horizon_after_not_finding[2]   = yes
##AHFinderDirect::dont_find_after_individual_time[2] = 30.  # FIXME: set this equal to merger time, leave commented until merger time has been figured out
AHFinderDirect::which_surface_to_store_info[2]       = 1


# ***** Parameters for the AH formed at merger *****
AHFinderDirect::origin_x[3] = 0.
AHFinderDirect::origin_y[3] = 0.
AHFinderDirect::origin_z[3] = 0.

AHFinderDirect::initial_guess__coord_sphere__x_center[3] = 0.
AHFinderDirect::initial_guess__coord_sphere__y_center[3] = 0.
AHFinderDirect::initial_guess__coord_sphere__z_center[3] = 0.
AHFinderDirect::initial_guess__coord_sphere__radius[3]   = 0.58

AHFinderDirect::patch_system_type[3]               = "full sphere"
AHFinderDirect::reset_horizon_after_not_finding[3] = yes
##AHFinderDirect::find_after_individual_time[3]    = 15.  # FIXME: set this equal to merger time, leave commented until merger time has been figured out
AHFinderDirect::which_surface_to_store_info[3]     = 2



# -------------------- Outflow -------------------------------------------------
Outflow::compute_every = $regrid_analysis_factor
Outflow::num_detectors = 5

Outflow::surface_index[0] = 0  # Puncture 1
Outflow::surface_index[1] = 1  # Puncture 2
Outflow::surface_index[2] = 2  # BH formed at merger

# Analysis surfaces
Outflow::surface_index[3] = 3
Outflow::surface_index[4] = 4
Outflow::surface_index[5] = 5

Outflow::interpolator_name = "Lagrange polynomial interpolation"
Outflow::interpolator_pars = "order=4"

Outflow::output_2d_data = yes
Outflow::out_format     = ".10e"

Outflow::verbose = 0



# -------------------- QuasiLocalMeasures --------------------------------------
QuasiLocalMeasures::interpolator         = "Lagrange polynomial interpolation"
QuasiLocalMeasures::interpolator_options = "order=4"
QuasiLocalMeasures::spatial_order        = 4

QuasiLocalMeasures::num_surfaces = 3  ##10

QuasiLocalMeasures::surface_index[0] = 0  # Puncture 1
QuasiLocalMeasures::surface_index[1] = 1  # Puncture 2
QuasiLocalMeasures::surface_index[2] = 2  # BH formed at merger

# Analysis surfaces
##QuasiLocalMeasures::surface_index[3] = 3
##QuasiLocalMeasures::surface_index[4] = 4
##QuasiLocalMeasures::surface_index[5] = 5
##QuasiLocalMeasures::surface_index[6] = 6
##QuasiLocalMeasures::surface_index[7] = 7
##QuasiLocalMeasures::surface_index[8] = 8
##QuasiLocalMeasures::surface_index[9] = 9

QuasiLocalMeasures::verbose = no



# -------------------- Multipole -----------------------------------------------
Multipole::nradii = 5
Multipole::ntheta = 120
Multipole::nphi   = 240

Multipole::radius[0] = 50.
Multipole::radius[1] = 70.
Multipole::radius[2] = 100.
Multipole::radius[3] = 150.
Multipole::l_max = 4

Multipole::variables = "
    WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='Psi4'}
"

# -------------------- WeylScal4 -----------------------------------------------
WeylScal4::offset   = 1.e-08  # Defaults to 1.e-15
WeylScal4::fd_order = "4th"
WeylScal4::verbose  = 0


# -------------------- ADMMass -------------------------------------------------
##ADMMass::ADMMass_surface_distance[0]                   = 200.
##ADMMass::ADMMass_use_all_volume_as_volume_radius       = no
##ADMMass::ADMMass_use_surface_distance_as_volume_radius = no
##ADMMass::ADMMass_volume_radius[0]                      = 1000.



# FIXME: activate or not?
# -------------------- Hydro_Analysis ------------------------------------------
##Hydro_Analysis::restmass_rho_min        = 1.e-13 #This should be equal to rho_abs_min
##Hydro_Analysis::restmass_masses_nr      = 0 #Zero means 'compute only the total baryonic mass'
##Hydro_Analysis::restmass_compute_masses = yes



# -------------------- NaNChecker ----------------------------------------------
NaNChecker::action_if_found = "terminate"
NaNChecker::check_after     = 0
NaNChecker::out_nanmask     = yes
NaNChecker::check_every     = $regrid_analysis_factor
NaNChecker::check_vars      = "
    IllinoisGRMHD::grmhd_primitives_allbutBi
    IllinoisGRMHD::grmhd_primitives_Bi
    IllinoisGRMHD::grmhd_conservatives
"





# ==============================================================================
# Output
# ==============================================================================

# -------------------- CarpetIOBasic -------------------------------------------
CarpetIOBasic::outInfo_every      = $regrid_analysis_factor
CarpetIOBasic::outInfo_reductions = "minimum maximum"
CarpetIOBasic::outInfo_vars       = "
    ADMBase::lapse
##    Compute_Anorm_Bnorm::Anorm  # **WARNING** Only meaningful every $reflevel_factor iterations
##    Compute_Anorm_Bnorm::Bnorm  # **WARNING** Only meaningful every $reflevel_factor iterations
    IllinoisGRMHD::rho_b
##    IllinoisGRMHD::grmhd_primitives_Bi
    smallbPoynET::smallb2       # **WARNING** Only meaningful every $reflevel_factor iterations
    ML_ADMConstraints::ml_ham
"



