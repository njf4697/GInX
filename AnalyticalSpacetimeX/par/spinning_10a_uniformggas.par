ActiveThorns = "InitBase Convert_to_HydroBase HydroBase IllinoisGRMHD ID_converter_ILGRMHD TmunuBase Vectors" 


# -------------------- InitBase ------------------------------------------------
InitBase::initial_data_setup_method = "init_some_levels"

# -------------------- HydroBase -----------------------------------------------
# ReadInterpolate ignores the following parameters, which are however required
# to allocate storage and for the evolution of the interpolated data

ActiveThorns = "Seed_Magnetic_Fields"
HydroBase::initial_hydro = "Uniform_Gas"

HydroBase::initial_Aphi  = "zero"
HydroBase::initial_Avec  = "zero"
Seed_Magnetic_Fields::Afield_type = "Uniform"
Seed_Magnetic_Fields::invbeta_uniform_bz = 1e-10
Seed_Magnetic_Fields::r_gap = 8
Seed_Magnetic_Fields::rho_b_init = 1.0
Seed_Magnetic_Fields::rho_b_atm_init = 1e-8
HydroBase::timelevels        = 3 ##1

# -------------------- TmunuBase -----------------------------------------------
TmunuBase::prolongation_type     = "none"
TmunuBase::stress_energy_at_rhs  = yes
TmunuBase::stress_energy_storage = yes
TmunuBase::timelevels            = 1
TmunuBase::support_old_CalcTmunu_mechanism = "no"

# -------------------- EOS -----------------------------------------------------

ID_converter_ILGRMHD::K_Initial     = 0.2 # 1e-3
ID_converter_ILGRMHD::Gamma_Initial = 1.3333 #1.66666666666667

IllinoisGRMHD::neos     = 1
IllinoisGRMHD::K_poly   = 0.2 #1e-3
IllinoisGRMHD::gamma_th = 1.3333333 #1.66666666666667
IllinoisGRMHD::verbose  = "no"

Seed_Magnetic_Fields::kappa   = 0.2 #1e-3
Seed_Magnetic_Fields::gamma = 1.333333 #1.66666666666667


# ----------------- IllinoisGRMHD ----------------------------------------------
CarpetLib::support_staggered_operators = yes
IllinoisGRMHD::conserv_to_prims_debug = 0
IllinoisGRMHD::Psi6threshold          = 1.5
IllinoisGRMHD::rho_b_max               = 10000
IllinoisGRMHD::gamma_speed_limit      = 10.   # Default  ##50.  # As in the SphericalNR run
IllinoisGRMHD::damp_lorenz            = 2.5 #75  # 1.5/dt_max  # As suggested by Zach Etienne
IllinoisGRMHD::tau_atm   = 5.0e-10
IllinoisGRMHD::rho_b_atm = 1.0e-8
IllinoisGRMHD::Symmetry               = "none"
IllinoisGRMHD::update_Tmunu           = no  # Decouple spacetime from matter evolution

