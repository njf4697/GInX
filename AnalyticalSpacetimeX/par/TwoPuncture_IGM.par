# ==============================================================================
# User-defined parameters
# ==============================================================================

# There are 13 refinement levels (including the coarsest one)
# -----------------------------------------------------------
#$Carpet_max_refinement_levels = 13
$Carpet_max_refinement_levels = 7
$reflevel_factor              = 32 #256  # 2^8  # See Carpet::time_refinement_factors below
$regrid_analysis_factor       = 32 #64   # 2^6  # See Carpet::time_refinement_factors below


# Number of collocation points used to solve the Hamiltonian and momentum
# constraint equations
# -----------------------------------------------------------------------
$n_collocation_points = 40


# Mass parameter for each of the two punctures
# --------------------------------------------
$par_m = 0.3066016  # Gives m ~= 0.5 for each puncture


# Position of puncture 1
# ----------------------
$x_punc1 = 10.0 
$y_punc1 = 0. 
$z_punc1 = 0.

# Position of puncture 2
# ----------------------
$x_punc2 = -10.0
$y_punc2 = 0.0
$z_punc2 = 0.


# Momentum of puncture 1
# ----------------------
$Px_punc1 = 0.0 
$Py_punc1 = 0.0630579
$Pz_punc1 = 0.

# Momentum of puncture 2
# ----------------------
$Px_punc2 = 0.0 
$Py_punc2 = -0.06305
$Pz_punc2 = 0.


# Spin of puncture 1
# ------------------
$Sx_punc1 = 0.
$Sy_punc1 = 0.
$Sz_punc1 = 0. 

# Spin of puncture 2
# -----------------
$Sx_punc2 = 0.
$Sy_punc2 = 0.
$Sz_punc2 = 0. 

# ==============================================================================



# ==============================================================================
# General setup
# ==============================================================================

# -------------------- Cactus ---------------------------------------------------
Cactus::cctk_run_title             = "TwoPuncture ID evolve in IGM"
Cactus::cctk_full_warnings         = yes
Cactus::highlight_warning_messages = no

Cactus::terminate   = "never" ##"iteration"
##Cactus::terminate   = "iteration"
Cactus::cctk_itlast = 0



# -------------------- Carpet --------------------------------------------------
Carpet::processor_topology = "automatic"  # Default

Carpet::domain_from_coordbase = yes
Carpet::convergence_level     = 0
Carpet::max_refinement_levels = $Carpet_max_refinement_levels
Carpet::refinement_centering  = "vertex"  ##"cell"
 
Carpet::ghost_size       = 3
Carpet::use_buffer_zones = yes

#Carpet::regrid_during_initialisation = no
#Carpet::regrid_during_recovery       = no
#Carpet::regrid_in_level_mode         = yes

Carpet::grid_structure_filename   = "carpet-grid-structure"
Carpet::grid_coordinates_filename = "carpet.grid"

Carpet::enable_all_storage = no

Carpet::init_fill_timelevels  = yes
Carpet::poison_new_timelevels = yes

#Carpet::num_integrator_substeps = 4

Carpet::prolongation_order_space = 5
Carpet::prolongation_order_time  = 2

Carpet::output_timer_tree_every = 8*$reflevel_factor  ##0
Carpet::output_timers_every     = 8*$reflevel_factor  ##0
##Carpet::timer_file              = ""  # Defaults to "carpet-timing-statistics"

Carpet::verbose = no

##Carpet::time_refinement_factors = "[1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096]"
#Carpet::time_refinement_factors = "[1, 1, 1, 1, 1,  2,  4,  8,  16,  32,  64,  128,  256]"
#Carpet::time_refinement_factors = "[1, 2, 4, 8, 16]"




# -------------------- CarpetLib -----------------------------------------------
CarpetLib::print_memstats_every        = 8*$reflevel_factor
CarpetLib::print_timestats_every       = 8*$reflevel_factor
CarpetLib::support_staggered_operators = yes

##CarpetLib::poison_new_memory = yes
##CarpetLib::poison_value      = 114



# -------------------- CarpetMask ----------------------------------------------
CarpetMask::excluded_surface[0] = 0
CarpetMask::excluded_surface[1] = 1
CarpetMask::excluded_surface[2] = 2

CarpetMask::excluded_surface_factor[0] = 1.
CarpetMask::excluded_surface_factor[1] = 1.
CarpetMask::excluded_surface_factor[2] = 1.

CarpetMask::verbose = no



# -------------------- IO ------------------------------------------------------
# Needed by ReadInterpolate
IO::filereader_ID_dir = "/work2/07825/lennoggi/frontera/CBD_493_140_280_SerialFFTfilter_64nodes_7OMP_checkpoints"

# Checkpointing
IO::checkpoint_dir                  = "../Checkpoint"
##IO::checkpoint_every                = 4096
IO::checkpoint_every_walltime_hours = 12.
IO::checkpoint_id                   = no
IO::checkpoint_keep                 = 1
IO::checkpoint_on_terminate         = yes

# Miscellaneous options
IO::out_dir                   = "Miscellaneous"
IO::abort_on_io_errors        = yes
IO::parfile_write             = "generate"
IO::print_timing_info         = yes
IO::strict_io_parameter_check = yes
IO::verbose                   = "full"

# Recovery
IO::recover     = "autoprobe"
IO::recover_dir = "../Checkpoint"

# Limit the number of MPI processes dumping 3D output files to disk in order to
# avoid stressing the filesystem
#
# ***** IMPORTANT *****
# Set this up so that only ONE 3D OUTPUT FILE PER NODE (for each grid function)
# is dumped to disk. For example, when using 7 OpenMP threads per MPI process
# (which means, on Frontera, 56/7=8 MPI processes per node), the following setup
# does the job:
#     IO::out_mode       = "np"
#     IO::out_proc_every = 8
#
IO::out_mode       = "np"  ##"one_file"
IO::out_proc_every = 8



# -------------------- LoopControl ---------------------------------------------
LoopControl::random_jump_probability = 0



# -------------------- TerminationTrigger --------------------------------------
TerminationTrigger::create_termination_file = yes
TerminationTrigger::max_walltime            = 48.
TerminationTrigger::on_remaining_walltime   = 15.  ##30.
TerminationTrigger::termination_file        = "../Terminate"
TerminationTrigger::termination_from_file   = yes



# -------------------- TimerReport ---------------------------------------------
TimerReport::out_every                  = 8*$reflevel_factor
TimerReport::out_filename               = "Timer_report.txt"
TimerReport::output_all_timers_readable = yes
TimerReport::output_all_timers          = yes





# ==============================================================================
# Grid
# ==============================================================================

# -------------------- CartGrid3D ----------------------------------------------
CartGrid3D::type = "coordbase"



# -------------------- CoordBase -----------------------------------------------
CoordBase::xmin = -256 #8192.  ## + 0.015625  # Off the z axis
CoordBase::xmax = +256 #8192.  ## + 0.015625  # Off the z axis
CoordBase::ymin = -256 #8192.  ## + 0.015625
CoordBase::ymax = +256 #8192.  ## + 0.015625  # Off the z axis
CoordBase::zmin = -256 #8192.
CoordBase::zmax = +256 #8192.

# To avoid interpolating at the origin of the destination grid
##CoordBase::boundary_staggered_x_lower = yes
##CoordBase::boundary_staggered_x_upper = yes
##CoordBase::boundary_staggered_y_lower = yes
##CoordBase::boundary_staggered_y_upper = yes
##CoordBase::boundary_staggered_z_lower = yes
##CoordBase::boundary_staggered_z_upper = yes

CoordBase::boundary_size_x_lower = 3
CoordBase::boundary_size_y_lower = 3
CoordBase::boundary_size_z_lower = 3
CoordBase::boundary_size_x_upper = 3
CoordBase::boundary_size_y_upper = 3
CoordBase::boundary_size_z_upper = 3

CoordBase::spacing    = "gridspacing"
CoordBase::domainsize = "minmax"

CoordBase::dx = 16 #64.
CoordBase::dy = 16 #64.
CoordBase::dz = 16 #64.



# -------------------- CarpetRegrid2 -------------------------------------------

# General parameters
# ------------------
CarpetRegrid2::regrid_every          = $regrid_analysis_factor
CarpetRegrid2::ensure_proper_nesting = yes
CarpetRegrid2::snap_to_coarse        = yes
CarpetRegrid2::min_distance          = 0.  # FIXME: double-check this
##CarpetRegrid2::verbose = yes


# Grid hierarchies
# ----------------
CarpetRegrid2::num_centres = 3

CarpetRegrid2::num_levels_1 = $Carpet_max_refinement_levels      # Hierarchy centered around puncture 1
CarpetRegrid2::num_levels_2 = $Carpet_max_refinement_levels      # Hierarchy centered around puncture 2
CarpetRegrid2::num_levels_3 = $Carpet_max_refinement_levels      #- 3  # Hierarchy centered around the origin


# Positions of the grid hierarchies
# ---------------------------------
CarpetRegrid2::position_x_1 = $x_punc1
CarpetRegrid2::position_y_1 = $y_punc1
CarpetRegrid2::position_z_1 = $z_punc1

CarpetRegrid2::position_x_2 = $x_punc2
CarpetRegrid2::position_y_2 = $y_punc2
CarpetRegrid2::position_z_2 = $z_punc2

CarpetRegrid2::position_x_3 = 0.
CarpetRegrid2::position_y_3 = 0.
CarpetRegrid2::position_z_3 = 0.


# Radii of the grid hierarchies
